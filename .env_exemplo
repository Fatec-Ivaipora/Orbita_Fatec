# Configurações do Firebase Órbita
FIREBASE_API_KEY=SUA_API_KEY_AQUI
FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
FIREBASE_PROJECT_ID=seu-projeto
FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:web:abcdef
FIREBASE_MEASUREMENT_ID=G-ABCDEF

# Leitura de fichas (módulo Ferida) — URL do serviço Python de OCR local
# (opcional; padrão http://127.0.0.1:5001 — ver /leitor-ficha/README.md)
LEITOR_FICHA_URL=http://127.0.0.1:5001

# Cofre de credenciais (módulo Acessos) — string longa e aleatória, usada
# para criptografar as senhas guardadas no banco (AES-256-GCM).
# Gere uma nova com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ Se trocar essa chave depois de já ter senhas cadastradas, elas não
# poderão mais ser decifradas — guarde-a com segurança (ex.: cofre de senhas
# da instituição), fora do repositório.
ACESSOS_ENCRYPTION_KEY=GERE_UMA_CHAVE_ALEATORIA_E_COLOQUE_AQUI

# Banco do Edubox (sistema acadêmico externo) — Postgres somente-leitura,
# usado por Confirmação de Presença em Evento (Docência) pra puxar os
# professores ativos do semestre vigente. Peça as credenciais pra
# coordenação/TI — usuário "consulta" só tem SELECT, nunca INSERT/UPDATE/DELETE.
EDUBOX_HOST=pgsqla.edubox.com.br
EDUBOX_PORT=5432
EDUBOX_DATABASE=edubox
EDUBOX_USER=SEU_USUARIO_AQUI
EDUBOX_PASSWORD=SUA_SENHA_AQUI

# Migração Secretaria DP — Apps Script
# Após criar uma nova implantação no Apps Script, cole a nova URL e defina um novo token.
# ⚠️ NUNCA coloque esses valores diretamente no código — use sempre o .env
SECRETARIA_DP_URL=URL_DA_NOVA_IMPLANTACAO_APPS_SCRIPT
SECRETARIA_DP_TOKEN=NOVO_TOKEN_QUE_VOCE_DEFINIR

# Relay Edubox (Relatório CPA) — VPS de IP fixo (mesmo servidor do relay do
# SIGMA, rotas /cpa/* isoladas por token próprio). Sem isso o módulo CPA
# não consegue buscar dado nenhum do Edubox.
EDUBOX_RELAY_URL=http://SEU_IP_FIXO:8443
EDUBOX_RELAY_TOKEN=TOKEN_DO_ORBITA_NO_RELAY

# Contratos › Rota de coleta: Google Routes API (melhor ordem de visita). Chave restrita à Routes API.
GOOGLE_MAPS_API_KEY=

# Portfólio Reflexivo (Medicina) › integração com o AVA (Open LMS) por web service — 24/11/2026.
# Endereço do AVA (sem / no fim) e o token do serviço "Órbita Medicina" (usuário orbita.integracao, papel ws_orbita_med só na categoria MED).
AVA_URL=https://endereco-do-ava
AVA_WS_TOKEN=

# Banco MED › Envio ao AVA (25/11/2026): login do usuário de INTEGRAÇÃO (orbita.integracao), nunca de pessoa.
# Só no .env do droplet (agente scripts/ava-banco-med-agente.js); não vai para o Vercel. Ver regras/regra_do_app.md, seção 8.
AVA_LOGIN_USUARIO=
AVA_LOGIN_SENHA=

# Custos de Nuvem (26/11/2026) › gasto do Google Cloud/Firebase (Órbita +
# SIGMA) via BigQuery Billing Export. Precisa estar ligado no Console do
# Google Cloud antes (Billing → Billing export → BigQuery); service account
# própria, só de leitura (bigquery.dataViewer + bigquery.jobUser + billing.viewer)
# — não reaproveitar a chave de admin do Firebase (serviceAccountKey.json).
GCP_BILLING_SA_KEY_PATH=
GCP_BILLING_QUERY_PROJECT=
GCP_BILLING_DATASET=billing_export.gcp_billing_export_v1_XXXXXX
GCP_FIREBASE_PROJECT_ID=orbita-fatecivp
GCP_SIGMA_PROJECT_ID=

# Custos de Nuvem › servidor do relay na DigitalOcean. Token de API, escopo
# "Billing", só leitura.
DIGITALOCEAN_API_TOKEN=
